# Copy to `.env` and adjust. `.env` is gitignored — never commit secrets.

# mock = offline heuristics (default). openai = pipeline + judge use gpt-4o-mini (needs key).
LLM_MODE=mock

# Required when LLM_MODE=openai
# OPENAI_API_KEY=

# Optional tracing / eval paths (defaults shown)
# TRACE_DB_PATH=data/traces.sqlite
# TRACE_JSONL_PATH=data/traces.jsonl
# EVAL_DATASET_PATH=eval/failure_dataset.jsonl
# HUMAN_FLAGS_PATH=data/human_flags.jsonl
